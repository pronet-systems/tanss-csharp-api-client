<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <Deterministic>true</Deterministic>
    <!-- IDE0005 (unbenutzte usings) wirkt beim Build nur mit Dokumentationsdatei. CS1591 dafuer stumm. -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);CA1848;CA1031;CS1591</NoWarn>
    <Company>ProNet Systems GmbH</Company>
    <Product>TANSS Sharp API Client</Product>
    <Description>Vollstaendiger .NET-Client fuer die TANSS-REST-API.</Description>
    <Authors>ProNet Systems GmbH</Authors>
    <!-- Nur die Bibliothek wird ein Paket; die Testprojekte tragen ihren eigenen Namen. -->
    <PackageId Condition="'$(MSBuildProjectName)' == 'Tanss.Api'">Tanss.Api</PackageId>
    <PackageProjectUrl>https://github.com/pronet-systems/tanss-sharp-api-client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/pronet-systems/tanss-sharp-api-client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>tanss;api;client;rest</PackageTags>
    <Copyright>Copyright (c) 2026 ProNet Systems GmbH</Copyright>
    <!-- Eine Quelle der Wahrheit fuer die Version. Alles andere leitet sich hiervon ab;
         dieselbe Schreibweise wie in den Schwesterprojekten, damit ein Skript die Zeile findet. -->
    <Version>1.0.0</Version>
    <FileVersion>$([System.Text.RegularExpressions.Regex]::Match($(Version), "^\d+(\.\d+){0,2}").Value).0</FileVersion>
    <InformationalVersion>$(Version)</InformationalVersion>
    <!-- Deutsche Fehlertexte, daher keine InvariantGlobalization. -->
  </PropertyGroup>
</Project>
